  "version": 1,
  "note": "日报信源清单。起点是 ai-concourse-library/config/guides.json 的 16 个官方源，补了订阅地址、来源分级和排除名单。搜索只算发现渠道，不计入成功率。brief_max 为 null 表示快讯不设上限。",
  "timezone": "Europe/Paris",
  "discovery_window_hours": 72,
  "minimum_success_rate": 0.9,
  "featured_max": 5,
  "brief_max": null,

  "tiers": {
    "official": "一手：公司、机构、议员、法院的官方发布。重点条目的首选。",
    "original": "原始报道：AP、Reuters、FT、The Information、Bloomberg、CNN、POLITICO 等自己采写的报道原文。",
    "relay": "转述：转引上面两类的二手报道。只能进快讯，且要写明转述自谁。"
  },
  "selection_rules": [
    "重点条目至少要有一个 official 或 original 链接，并且打开过原文。只有 relay 的，最多进快讯。",
    "lead_only_domains 里的站点只能提供线索，不能作为任何条目的唯一来源。",
    "blocked_domains 里的站点不得引用，也不得作为线索。",
    "金额、票数、star 数、估值这类数字，必须由主线程用官网或 API 复核；子代理给出的数字只算线索。",
    "标题和 description 里不写只有 relay 来源的数字。"
  ],

